{
  "name": "frontend",
  "version": "0.1.0",
  "bin": {
    "frontend": "bin/frontend.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "lint": "npx eslint --ignore-pattern .ts,.tsx --no-error-on-unmatched-pattern lib bin test",
    "lint:fix": "npx eslint --ignore-pattern .ts,.tsx --fix --no-error-on-unmatched-pattern lib bin test",
    "format": "prettier --ignore-path .gitignore --write '**/*.+(js|ts|json)'"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@stylistic/eslint-plugin": "^2.12.1",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.7.9",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "aws-cdk": "2.173.2",
    "eslint": "^9.17.0",
    "eslint-config-love": "^114.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-cdk": "^1.8.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.19.1"
  },
  "dependencies": {
    "@aws-cdk/aws-cloudfront": "^1.203.0",
    "@aws-cdk/aws-s3": "^1.203.0",
    "@aws-cdk/aws-s3-deployment": "^1.203.0",
    "@aws-sdk/client-route-53": "^3.728.0",
    "@aws-sdk/client-sts": "^3.726.1",
    "@aws-sdk/credential-providers": "^3.726.1",
    "aws-cdk-lib": "2.173.2",
    "aws-sdk": "^2.1692.0",
    "constructs": "^10.0.0",
    "js-yaml": "^4.1.0"
  }
}
