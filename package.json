{
  "name": "tokenlint-vscode",
  "displayName": "TokenLint",
  "description": "AI runtime observability platform for prompts, skills, MCP workflows, and cognitive security in VS Code",
  "version": "2.1.0",
  "publisher": "tokenlint",
  "repository": {
    "type": "git",
    "url": "https://github.com/clbt-8d14fd5e/token-lint"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tokenlint.scanCurrentFile",
        "title": "TokenLint: Scan Current File"
      },
      {
        "command": "tokenlint.scanWorkspace",
        "title": "TokenLint: Scan Workspace"
      },
      {
        "command": "tokenlint.scanOrFix",
        "title": "TokenLint: Scan / Fix..."
      },
      {
        "command": "tokenlint.setCopilotBudget",
        "title": "TokenLint: Set Copilot Budget"
      },
      {
        "command": "tokenlint.analyzeOpenFilesBudget",
        "title": "TokenLint: Analyze Open Files Budget"
      },
      {
        "command": "tokenlint.showCopilotBudget",
        "title": "TokenLint: Show Copilot Budget"
      },
      {
        "command": "tokenlint.openRuntimeDashboard",
        "title": "TokenLint: Open Cost Dashboard"
      },
      {
        "command": "tokenlint.saveRuntimeSnapshot",
        "title": "TokenLint: Save Runtime Snapshot"
      },
      {
        "command": "tokenlint.showRuntimeHistory",
        "title": "TokenLint: Show Runtime History"
      },
      {
        "command": "tokenlint.diffRuntimeAgainstPrevious",
        "title": "TokenLint: Diff Runtime Against Previous Snapshot"
      },
      {
        "command": "tokenlint.diffRuntimeAgainst7Days",
        "title": "TokenLint: Diff Runtime Against 7 Days Ago"
      },
      {
        "command": "tokenlint.diffRuntimeAgainstBaseline",
        "title": "TokenLint: Diff Runtime Against Baseline"
      },
      {
        "command": "tokenlint.clearOldRuntimeHistory",
        "title": "TokenLint: Clear Old Runtime History"
      },
      {
        "command": "tokenlint.showCostAnalysis",
        "title": "TokenLint: Show Cost Analysis"
      },
      {
        "command": "tokenlint.analyzeCacheEfficiency",
        "title": "TokenLint: Analyze Cache Efficiency"
      },
      {
        "command": "tokenlint.analyzeRetrievalAmplification",
        "title": "TokenLint: Analyze Retrieval Amplification"
      },
      {
        "command": "tokenlint.analyzeWorkspaceBudget",
        "title": "TokenLint: Analyze Workspace Budget"
      },
      {
        "command": "tokenlint.generateReport",
        "title": "TokenLint: Generate Report"
      },
      {
        "command": "tokenlint.showIR",
        "title": "TokenLint: Show IR"
      },
      {
        "command": "tokenlint.applyAllSafeFixes",
        "title": "TokenLint: Apply All Safe Fixes"
      },
      {
        "command": "tokenlint.showFixGraph",
        "title": "TokenLint: Show Before / After Graph"
      }
    ],
    "configuration": {
      "title": "TokenLint",
      "properties": {
        "tokenlint.maxPromptTokens": {
          "type": "number",
          "default": 4000,
          "description": "Token threshold for large prompt warning"
        },
        "tokenlint.criticalPromptTokens": {
          "type": "number",
          "default": 8000,
          "description": "Token threshold for critical prompt warning"
        },
        "tokenlint.maxTopK": {
          "type": "number",
          "default": 10,
          "description": "Retrieval top_k threshold"
        },
        "tokenlint.enableSecurityScanner": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI skill and prompt security scanner"
        },
        "tokenlint.copilotBudget": {
          "type": "number",
          "default": 128000,
          "description": "Configured GitHub Copilot context budget in tokens"
        },
        "tokenlint.warningThresholdPercent": {
          "type": "number",
          "default": 70,
          "description": "Usage percentage that marks the Copilot budget meter as high risk"
        },
        "tokenlint.criticalThresholdPercent": {
          "type": "number",
          "default": 90,
          "description": "Usage percentage that marks the Copilot budget meter as critical"
        },
        "tokenlint.includeWorkspaceEstimate": {
          "type": "boolean",
          "default": true,
          "description": "Include the workspace-wide context estimate in the Copilot budget meter"
        },
        "tokenlint.includeRetrievalAmplification": {
          "type": "boolean",
          "default": true,
          "description": "Include retrieval amplification estimates when calculating Copilot context pressure"
        },
        "tokenlint.runtimeTimeWindowDays": {
          "type": "number",
          "default": 7,
          "enum": [
            1,
            7,
            30
          ],
          "description": "Default runtime dashboard time window in days"
        },
        "tokenlint.history.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable local runtime history snapshots and diff analysis."
        },
        "tokenlint.history.retentionDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "How many days of runtime snapshots to retain locally."
        },
        "tokenlint.history.maxSnapshots": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "description": "Maximum number of runtime snapshots to retain locally."
        },
        "tokenlint.history.snapshotOnScan": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save a runtime snapshot after scan-driven budget refreshes."
        },
        "tokenlint.history.snapshotOnDashboardOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save a runtime snapshot when the runtime dashboard opens."
        },
        "tokenlint.history.baseline": {
          "type": "string",
          "default": "latest",
          "description": "Baseline strategy for runtime diffs. Use 'latest' or a saved snapshot id."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokenlint",
          "title": "TokenLint",
          "icon": "media/tokenlint.svg"
        }
      ]
    },
    "views": {
      "tokenlint": [
        {
          "id": "tokenlint.sidebar",
          "name": "TokenLint",
          "type": "webview",
          "icon": "media/tokenlint.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "tokenlint.scanCurrentFile",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@1"
        },
        {
          "command": "tokenlint.scanWorkspace",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@2"
        },
        {
          "command": "tokenlint.scanOrFix",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@3"
        },
        {
          "command": "tokenlint.openRuntimeDashboard",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@4"
        },
        {
          "command": "tokenlint.showCopilotBudget",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@5"
        },
        {
          "command": "tokenlint.analyzeWorkspaceBudget",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@6"
        },
        {
          "command": "tokenlint.applyAllSafeFixes",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@7"
        },
        {
          "command": "tokenlint.generateReport",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@8"
        },
        {
          "command": "tokenlint.showIR",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@9"
        },
        {
          "command": "tokenlint.showFixGraph",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@10"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "vsce package",
    "release:local": "node ./scripts/release-local-extension.mjs"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.1.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^4.1.6",
    "@vscode/vsce": "^2.15.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  }
}
