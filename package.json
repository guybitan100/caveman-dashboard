    "test:run": "npm run test:run -w web",
    "test:coverage": "npm run test:coverage -w web",
    "test:e2e": "npm run test:e2e -w web",
    "test:e2e:ui": "npm run test:e2e:ui -w web",
    "test:e2e:debug": "npm run test:e2e:debug -w web"
  }
