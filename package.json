{
  "name": "caveman-dashboard",
  "displayName": "Caveman Dashboard",
  "description": "Track token savings from the caveman output-compression plugin across Claude Code and GitHub Copilot, right inside VS Code.",
  "version": "0.7.0",
  "publisher": "tokenlint",
  "repository": {
    "type": "git",
    "url": "https://github.com/clbt-8d14fd5e/token-lint"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cavemanDashboard.openDashboard",
        "title": "Open Dashboard",
        "category": "Caveman"
      },
      {
        "command": "cavemanDashboard.refresh",
        "title": "Refresh Savings",
        "category": "Caveman"
      },
      {
        "command": "cavemanDashboard.checkUpdate",
        "title": "Check for Caveman Update",
        "category": "Caveman"
      }
    ],
    "configuration": {
      "title": "Caveman Dashboard",
      "properties": {
        "cavemanDashboard.showCost": {
          "type": "boolean",
          "default": false,
          "description": "Show estimated USD cost figures alongside token savings (Claude Code only)."
        },
        "cavemanDashboard.claudeProjectsPath": {
          "type": "string",
          "default": "",
          "description": "Override the Claude config directory used to read caveman history and transcripts. Defaults to $CLAUDE_CONFIG_DIR or ~/.claude."
        },
        "cavemanDashboard.vscodeUserPath": {
          "type": "string",
          "default": "",
          "description": "Override the VS Code User directory used to find GitHub Copilot chat transcripts. Defaults to the per-OS location."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.15.0",
    "typescript": "^5.4.0"
  }
}
