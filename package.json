{
  "name": "tokenlint-vscode",
  "displayName": "TokenLint",
  "description": "Compiler-style prompt, AI skill, MCP, and cognitive security linter for VS Code",
  "version": "0.2.0",
  "publisher": "tokenlint",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:tokenlint.scanCurrentFile",
    "onCommand:tokenlint.scanWorkspace",
    "onCommand:tokenlint.generateReport",
    "onCommand:tokenlint.showIR",
    "onCommand:tokenlint.applyAllSafeFixes",
    "onView:tokenlint.sidebar"
  ],
  "main": "./out/extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tokenlint.scanCurrentFile",
        "title": "TokenLint: Scan Current File"
      },
      {
        "command": "tokenlint.scanWorkspace",
        "title": "TokenLint: Scan Workspace"
      },
      {
        "command": "tokenlint.generateReport",
        "title": "TokenLint: Generate Report"
      },
      {
        "command": "tokenlint.showIR",
        "title": "TokenLint: Show IR"
      },
      {
        "command": "tokenlint.applyAllSafeFixes",
        "title": "TokenLint: Apply All Safe Fixes"
      }
    ],
    "configuration": {
      "title": "TokenLint",
      "properties": {
        "tokenlint.maxPromptTokens": {
          "type": "number",
          "default": 4000,
          "description": "Token threshold for large prompt warning"
        },
        "tokenlint.criticalPromptTokens": {
          "type": "number",
          "default": 8000,
          "description": "Token threshold for critical prompt warning"
        },
        "tokenlint.maxTopK": {
          "type": "number",
          "default": 10,
          "description": "Retrieval top_k threshold"
        },
        "tokenlint.enableSecurityScanner": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI skill and prompt security scanner"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokenlint",
          "title": "TokenLint",
          "icon": "media/tokenlint.svg"
        }
      ]
    },
    "views": {
      "tokenlint": [
        {
          "id": "tokenlint.sidebar",
          "name": "TokenLint"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.1.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.15.0"
  }
}