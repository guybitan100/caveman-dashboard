# Source and config not needed at runtime
src/**
tsconfig.json
.gitignore
.github/**
.claude/**

# Misc
*.vsix
.vscode/**
node_modules/.package-lock.json
package-lock.json
node_modules/**

# Sourcemaps not needed at runtime (big bytes, esp. gpt-tokenizer)
**/*.js.map
node_modules/**/*.ts
out/**/*.js
!out/extension.js
